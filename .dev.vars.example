# First-run secrets, prompted by Deploy to Cloudflare. Leave these placeholders empty.
# For local development, copy this file to .dev.vars and enter your own values.
# Optional settings and JSON formats: config/optional-secrets.example

# Discord Developer Portal > your application > Bot > token.
DISCORD_BOT_TOKEN=""
# Destination text channel IDs, comma-separated. Discord Developer Mode > Copy Channel ID.
DISCORD_CHANNEL_IDS=""
# Required ICAO callsign prefixes to watch (comma-separated, 1–4 letters each).
FIR_PREFIXES=""
# Generate a unique value with: openssl rand -hex 32
# Save it privately for authenticated health checks and manual polling.
POLL_SECRET=""
