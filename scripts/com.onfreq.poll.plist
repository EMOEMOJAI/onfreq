<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent that triggers the bot's poll endpoint every 60s.
  Install or upgrade it only with the steps in docs/setup.md, section
  "Health and optional Mac fallback" (docs/setup.md#health-and-optional-mac-fallback).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.onfreq.poll</string>

    <!-- POSIX sh, as tested; zsh would source ~/.zshenv (proxy or TLS
         logging settings) before the token is sent. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>__HOME__/.onfreq/poll-trigger.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- The script writes its own timestamped log; these catch anything that
         escapes it (a syntax error, a missing interpreter). -->
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/onfreq-poll.err.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/onfreq-poll.err.log</string>

    <!-- 63 = octal 077: log files launchd creates are private (0600). -->
    <key>Umask</key>
    <integer>63</integer>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
