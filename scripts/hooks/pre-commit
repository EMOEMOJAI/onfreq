#!/bin/sh
# Blocks any commit whose staged changes contain a secret.
#
# .gitignore only protects files whose *names* match a pattern; it does nothing
# about a token pasted into a source file. This catches that case.
#
# Install per clone (Git does not version hooks); see README.md. If the
# directory `git rev-parse --git-path hooks` prints has hooks other than
# *.sample, keep them and call this file from their pre-commit at the
# repository root.
# Otherwise:
#   git config core.hooksPath scripts/hooks
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  printf 'pre-commit: install gitleaks before committing (https://github.com/gitleaks/gitleaks).\n' >&2
  exit 1
fi

# shellcheck source-path=SCRIPTDIR/../.. source=scripts/hooks/lib/gitleaks-settings.sh
. scripts/hooks/lib/gitleaks-settings.sh
gitleaks_settings_guard pre-commit Stage commit || exit 1

if ! tmp=$(mktemp -d); then
  printf 'pre-commit: BLOCKED — could not create a temporary directory.\n' >&2
  exit 1
fi
trap 'rm -rf "$tmp"' EXIT
trap 'exit 1' HUP INT TERM

# Scan the literal staged bytes: external diff drivers, textconv filters and
# binary attributes could otherwise hide a staged secret from gitleaks. A failed
# Git stage leaves a marker, so unreadable staged changes block the commit.
status=0
output=$({ git diff --cached --no-ext-diff --no-textconv --no-color --text </dev/null ||
    : >"$tmp/failed"; } | gitleaks stdin --no-banner --redact 2>&1) || status=$?
if [ -e "$tmp/failed" ]; then
  printf '\n%s\n' "$output" >&2
  printf '\npre-commit: BLOCKED — could not read the staged changes for the secret scan.\n' >&2
  exit 1
fi
if [ "$status" != 0 ]; then
  printf '\n%s\n' "$output" >&2
  printf '\npre-commit: BLOCKED — staged changes look like they contain a secret.\n' >&2
  printf 'Unstage it, move the value into .dev.vars (gitignored) or a Wrangler secret.\n' >&2
  printf 'If it is genuinely a false positive, append a "gitleaks:allow" comment on that line.\n' >&2
  exit 1
fi

exit 0
