#!/bin/sh
# Blocks any commit whose staged changes contain a secret.
#
# .gitignore only protects files whose *names* match a pattern; it does nothing
# about a token pasted into a source file. This catches that case.
#
# Install per clone (Git does not version hooks); see README.md. If the
# directory `git rev-parse --git-path hooks` prints has hooks other than
# *.sample, keep them and call this file from their pre-commit at the
# repository root.
# Otherwise:
#   git config core.hooksPath scripts/hooks
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  printf 'pre-commit: install gitleaks before committing (https://github.com/gitleaks/gitleaks).\n' >&2
  exit 1
fi

# shellcheck source-path=SCRIPTDIR/../.. source=scripts/hooks/lib/gitleaks-settings.sh
. scripts/hooks/lib/gitleaks-settings.sh
gitleaks_settings_guard pre-commit Stage commit || exit 1
gitleaks_version_notice pre-commit

if ! tmp=$(mktemp -d); then
  printf 'pre-commit: BLOCKED — could not create a temporary directory.\n' >&2
  exit 1
fi
trap 'rm -rf "$tmp"' EXIT
trap 'exit 1' HUP INT TERM

# Scan the literal staged bytes: external diff drivers, textconv filters and
# binary attributes could otherwise hide a staged secret from gitleaks. As in
# scripts/secret-scan.sh, context and removed lines are dropped, as is the
# existing line Git appends to each hunk header (@@ -2 +2 @@ <line>), so a
# commit that removes a leaked secret, or edits a line below one, is not blocked
# by it; --inter-hunk-context=0 keeps diff.interHunkContext from merging nearby
# hunks and adding existing lines back as context, and GIT_DIFF_OPTS is unset
# because it would override -U0 in the same way. A failed Git or filter stage
# leaves a marker, so unreadable staged changes block the commit. As there, a
# 36 000-byte preamble keeps Gitleaks from skipping the input as a binary file,
# and NUL bytes become spaces before the shared filter
# scripts/hooks/lib/scan-stream.awk adds the blank lines that keep a line, a
# private key or a continued curl command from being cut between chunks. A
# line over 20 000 bytes could still be cut, so the filter exits 3 for one,
# which leaves its own marker and blocks the commit; no inline allow comment
# passes it.
unset GIT_DIFF_OPTS
filter=scripts/hooks/lib/scan-stream.awk
if [ ! -r "$filter" ]; then
  printf 'pre-commit: BLOCKED — missing the stream filter %s.\n' "$filter" >&2
  exit 1
fi
preamble() { LC_ALL=C awk 'BEGIN { for (i = 0; i < 1200; i++) print "# onfreq secret-scan preamble" }' </dev/null; }
status=0
output=$({ { preamble && git diff --cached -U0 --inter-hunk-context=0 --no-ext-diff --no-textconv --no-color --text </dev/null; } ||
    : >"$tmp/failed"; } |
  { LC_ALL=C sed -e '/^-/d' -e 's/^\(@@ -[0-9][0-9,]* +[0-9][0-9,]* @@\).*/\1/' || : >"$tmp/failed"; } |
  { LC_ALL=C tr '\000' ' ' || : >"$tmp/failed"; } |
  { LC_ALL=C awk -f "$filter" || case $? in (3) : >"$tmp/long" ;; (*) : >"$tmp/failed" ;; esac; } |
  gitleaks stdin --no-banner --redact 2>&1) || status=$?
if [ -e "$tmp/failed" ] || [ "$status" != 0 ]; then printf '\n%s\n' "$output" >&2; fi
if [ -e "$tmp/long" ]; then
  printf '\npre-commit: BLOCKED — the secret scan cannot read lines over 20 000 bytes whole; split the line into shorter lines.\n' >&2
  if [ -e "$tmp/failed" ]; then
    printf 'pre-commit: the staged changes also could not be read for the secret scan; see the output above.\n' >&2
  fi
  if [ "$status" != 0 ]; then
    printf 'pre-commit: the secret scan also failed or found a secret; see the output above.\n' >&2
  fi
  exit 1
fi
# A Gitleaks that exits before reading all its input, for example on a bad
# configuration, makes Git or sed fail on the closed pipe, so both causes are
# named.
if [ -e "$tmp/failed" ] && [ "$status" != 0 ]; then
  printf '\npre-commit: BLOCKED — could not read the staged changes for the secret scan, or the scan failed; see the output above.\n' >&2
  exit 1
fi
if [ -e "$tmp/failed" ]; then
  printf '\npre-commit: BLOCKED — could not read the staged changes for the secret scan.\n' >&2
  exit 1
fi
# Gitleaks exits non-zero both for findings and for its own errors.
if [ "$status" != 0 ]; then
  printf '\npre-commit: BLOCKED — the secret scan failed or found a secret; see the output above.\n' >&2
  printf 'For a finding, unstage it and move the value into .dev.vars (gitignored) or a Wrangler secret.\n' >&2
  printf 'If a finding is genuinely a false positive, append a "gitleaks:allow" comment on that line.\n' >&2
  exit 1
fi

exit 0
