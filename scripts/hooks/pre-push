#!/bin/sh
# Blocks a push until Gitleaks, publication privacy and deployment setup checks
# pass, so secrets, tracked private files or operator settings are caught before
# publication, including in commits that skipped the pre-commit hook.
#
# Install alongside pre-commit, per clone; see README.md. If the directory
# `git rev-parse --git-path hooks` prints has hooks other than *.sample, such
# as a private-history push guard, keep them and call this file from their
# pre-push at the repository root with the same arguments and standard input.
# Otherwise:
#   git config core.hooksPath scripts/hooks
set -eu

if ! command -v npm >/dev/null 2>&1 || ! command -v node >/dev/null 2>&1; then
  printf 'pre-push: install Node.js 24 and run npm ci before pushing.\n' >&2
  exit 1
fi
if ! command -v gitleaks >/dev/null 2>&1; then
  printf 'pre-push: install gitleaks before pushing (https://github.com/gitleaks/gitleaks).\n' >&2
  exit 1
fi

# The index checks cover the pushed tree only when every pushed commit is HEAD
# and the index matches HEAD. The range check then covers every file version
# and commit email in the pushed commits, not only the final tree.
if ! head=$(git rev-parse --verify --quiet HEAD); then
  printf 'pre-push: BLOCKED — no HEAD commit to check.\n' >&2
  exit 1
fi
# Git passes <remote name> <url>; a wrapper may omit them.
remote=${1:-}
blocked=false
set --
# stdin lines: <local ref> <local oid> <remote ref> <remote oid>. The -n test
# also handles a final line without a newline.
while read -r _local_ref local_oid _remote_ref remote_oid || [ -n "${local_oid:-}" ]; do
  case "$local_oid" in
    '') ;;
    *[!0]*)
      if [ "$local_oid" = "$head" ]; then set -- "$@" "${remote_oid:-}"; else blocked=true; fi ;;
    *) ;; # all zeros: a deletion pushes no content
  esac
  local_oid=
done
if [ "$blocked" = true ]; then
  printf 'pre-push: BLOCKED — pushed commits must be the checked-out HEAD.\n' >&2
  printf 'Check out the commit you want to publish, then push it from a clean checkout of HEAD.\n' >&2
  exit 1
fi
if ! git diff --cached --quiet --no-ext-diff --no-textconv --ignore-submodules=none HEAD --; then
  printf 'pre-push: BLOCKED — staged changes differ from HEAD, so the checks would not cover the pushed commit.\n' >&2
  printf 'Commit or unstage them, then push from a clean checkout of HEAD.\n' >&2
  exit 1
fi
# The checks run from the working tree, so their code and the Gitleaks
# configuration and ignore list read from it must match HEAD.
if ! git diff --quiet --no-ext-diff --no-textconv -- package.json package-lock.json scripts/ .gitleaks.toml .gitleaksignore; then
  printf 'pre-push: BLOCKED — unstaged changes to package files, scripts/ or Gitleaks settings would change the checks.\n' >&2
  printf 'Commit, stash or discard them, then push.\n' >&2
  exit 1
fi
if ! untracked=$(git ls-files --others --exclude-standard -- scripts/) || [ -n "$untracked" ]; then
  printf 'pre-push: BLOCKED — untracked files under scripts/ would change the checks.\n' >&2
  printf 'Commit, ignore or remove them, then push.\n' >&2
  exit 1
fi
# Sourced only after the checks above confirm scripts/ matches HEAD.
# shellcheck source-path=SCRIPTDIR/../.. source=scripts/hooks/lib/gitleaks-settings.sh
. scripts/hooks/lib/gitleaks-settings.sh
gitleaks_settings_guard pre-push Commit push || exit 1

# Scans one pushed ref. check-privacy.mjs computes the range, one revision
# argument per line, for both the secret scan and its own range check: HEAD
# minus the remote ref's old commit, when present, and the pushed remote's
# tracking refs.
scan_range() {
  range=$1
  set --
  while IFS= read -r arg; do
    if [ -n "$arg" ]; then set -- "$@" "$arg"; fi
  done <<EOF
$range
EOF
  sh scripts/secret-scan.sh "$@" </dev/null
}

# New commits per ref. The checks never print matched private values; Gitleaks redacts.
failed=false
scan_failed=false
unreadable=false
scan_unreadable=false
for remote_oid in "$@"; do
  if range=$(node scripts/check-privacy.mjs --range-args "$head" "$remote_oid" "$remote" </dev/null); then
    status=0
    output=$(scan_range "$range" 2>&1) || status=$?
    case "$status" in
      0) ;;
      2) scan_unreadable=true ;;
      *) scan_failed=true ;;
    esac
    if [ "$status" != 0 ]; then printf '\n%s\n' "$output" >&2; fi
  else
    unreadable=true
  fi
  npm run --silent check:privacy -- --range "$head" "$remote_oid" "$remote" </dev/null || failed=true
done
if [ "$unreadable" = true ]; then
  printf '\npre-push: BLOCKED — could not read the pushed commits for the secret scan.\n' >&2
  exit 1
fi
# Status 2 can also follow a Gitleaks failure: a Gitleaks that stops reading
# early makes Git fail on the closed pipe. The scan's output above says which.
if [ "$scan_unreadable" = true ]; then
  printf '\npre-push: BLOCKED — could not read the pushed commits for the secret scan, or the scan failed; see the output above.\n' >&2
  exit 1
fi
# Gitleaks exits non-zero both for findings and for its own errors.
if [ "$scan_failed" = true ]; then
  printf '\npre-push: BLOCKED — the secret scan failed or found a secret in the pushed commits; see the output above.\n' >&2
  printf 'For a finding, rewrite the unpublished commits to remove it and rotate the value; move it into .dev.vars (gitignored) or a Wrangler secret.\n' >&2
  printf 'If a finding is genuinely a false positive, append a "gitleaks:allow" comment on that line.\n' >&2
  exit 1
fi
if [ "$failed" = true ] || ! npm run --silent check:privacy </dev/null || ! npm run --silent check:setup </dev/null; then
  printf '\npre-push: BLOCKED — privacy or deployment setup checks failed.\n' >&2
  printf 'Fix the reported files locally before pushing; rewrite unpublished commits that add private files.\n' >&2
  exit 1
fi

exit 0
