node_modules/
.wrangler/
worker-configuration.d.ts
.DS_Store

# --- Secrets: never commit -------------------------------------------------
# Wrangler local secrets (DISCORD_BOT_TOKEN, IVAO_CLIENT_SECRET, POLL_SECRET…)
.dev.vars
.dev.vars.*
!.dev.vars.example

# Generic env files, in case tooling ever writes one here
.env
.env.*
!.env.example
# direnv files export variables, often real secrets
.envrc
.envrc.*
!.envrc.example
.envrc.example/

# Key material and ad-hoc secret dumps. Bracket classes match these and the
# other endings check:privacy treats case-insensitively in any case, even with
# core.ignorecase off.
*.[pP][eE][mM]
*.[kK][eE][yY]
*.[pP]12
*.[pP][fF][xX]
secrets.json
*-[sS][eE][cC][rR][eE][tT]
*-[sS][eE][cC][rR][eE][tT].[tT][xX][tT]
poll-secret
poll-endpoint

# Local, operator-specific helper scripts (may contain real IDs)
*.[lL][oO][cC][aA][lL].[sS][hH]
wrangler.local.*

# npm registry credentials
.npmrc

# Local logs and privacy/secret scan reports can contain sensitive matches.
*.[lL][oO][gG]
gitleaks-report.*

# Private agent preferences, local tool permissions and other local-only
# settings or notes, in any directory, as check:privacy rejects them.
*.[lL][oO][cC][aA][lL].[mM][dD]
*.[lL][oO][cC][aA][lL].[jJ][sS][oO][nN]
*.[lL][oO][cC][aA][lL].[jJ][sS][oO][nN][cC]

# Local audit notes and original image-generation downloads.
.local/
docs/pr-audit-*.md
/nano-banana-*.png

# Operator settings; only the public optional-settings template is tracked,
# never a directory of that name or any other file.
config/*
!config/optional-secrets.example
config/optional-secrets.example/
