# Optional settings for your own deployment. Keep real values out of Git.
# Add only the settings you need to .dev.vars for local development, or as
# encrypted Worker secrets in Cloudflare Settings > Variables and Secrets.
# Never add bot secrets to Workers Builds variables or GitHub Actions.

# Optional role ID to ping when ATC comes online. Empty or invalid disables
# the mention.
MENTION_ROLE_ID=""
# Minutes before the role is pinged again in the same channel (default 10;
# 0 allows one ping per channel per poll).
MENTION_COOLDOWN_MINUTES=""

# --- Monitored airspace ----------------------------------------------------
# Optional private roster labels. Fictional example:
# [{"prefixes":["XA"],"flag":"🌐","name":"Example"}]
# Names: 1–12 characters; flag: country flag or globe; prefixes must not overlap.
# Empty uses neutral labels. Never commit real coverage or display mappings.
FIR_LABELS=""
# Callsigns that never trigger notifications (comma-separated, exact match).
EXCLUDED_CALLSIGNS=""

# --- Guest Controller Approval reminders (optional) ------------------------
# "true" enables reminder DMs. Anything else keeps them off.
GCA_DM_ENABLED="false"
# Discord server and member role used to map IVAO member IDs to accounts.
GCA_DISCORD_GUILD_ID=""
GCA_MEMBER_ROLE_ID=""
# Optional but strongly recommended: a role only staff assign after verifying
# a member's VID. When set, a nickname VID is trusted only for members holding
# it, for GCA and short-session reminders. An invalid value disables both.
GCA_VERIFIED_ROLE_ID=""
# Optional staff account that receives a copy of each confirmed reminder.
GCA_COPY_USER_ID=""
# Private coverage as JSON (fictional example; replace with your own policy):
# {"AA":{"name":"Example region","prefixes":["XA"],"homeCountries":["AA","AB"]}}
# Region keys and home countries are uppercase two-letter codes. homeCountries
# defaults to [region]; it must include the region. Prefixes are 1–4 uppercase
# letters and must not overlap. Home countries cannot belong to multiple regions.
# Missing or malformed coverage disables reminders. Never commit real coverage.
GCA_REGIONS=""
# Approval records, as JSON: {"<member id>":[{"region":"AA","level":3}]}
# Region must exist in GCA_REGIONS. Levels: 1 DEL/GND/TWR, 2 APP/DEP, 3 CTR.
# `{}` means nobody is approved.
# Reminders stay OFF until this parses: an empty record would accuse
# controllers who do hold an approval.
GCA_APPROVALS=""
# Home-region overrides, as JSON: {"<member id>":"AA"}. Optional.
GCA_HOME_OVERRIDES=""
# Optional https link to the division's GCA policy, included in the DM.
# A set but invalid link, or one longer than 2048 characters, disables reminders.
GCA_POLICY_URL=""

# --- Short-session reminders (optional) ------------------------------------
# "true" DMs a controller whose time online in the division (any position)
# provably lasted under 30 minutes, with a one-minute margin, if they are not
# back online when it falls due 10 minutes later; at most one per member per
# 24 h. While on, it stores the VID and online times of every division ATC
# member until an hour after they leave; members already online when it is
# switched on are not reminded for that time online. Independent of
# GCA_DM_ENABLED and the GCA policy, but requires valid GCA_DISCORD_GUILD_ID
# and GCA_MEMBER_ROLE_ID and honours GCA_VERIFIED_ROLE_ID like GCA reminders;
# invalid IDs keep it off.
# "purge" sends nothing and drops all short-session data on each poll: to roll
# back, set it, let one poll run, then revert. Anything else is off.
SHORT_SESSION_DM_ENABLED=""

# --- IVAO API (optional) ---------------------------------------------------
# OAuth2 client credentials (developers portal -> your application).
# Without them the bot falls back to unauthenticated requests. If the tracker
# rejects the bot's token (a new one with 401, or any with 403), the feed is
# fetched anonymously for 30 minutes, then credentials are tried again.
IVAO_CLIENT_ID=""
IVAO_CLIENT_SECRET=""

# --- Private history endpoints (optional) ----------------------------------
# Bearer secret for GET /gca-history and /gca-history/cleanup, separate from
# POLL_SECRET. At least 32 characters: openssl rand -hex 32
# Empty or shorter values disable these endpoints.
HISTORY_SECRET=""

# --- IVAO webhook (optional) -----------------------------------------------
# Signing Secret of an IVAO webhook (developers portal -> your application ->
# Webhooks) for POST /ivao/webhook. A verified ATC connection event only
# schedules an earlier poll. Empty, shorter than 32 characters or equal to
# POLL_SECRET, HISTORY_SECRET, IVAO_CLIENT_SECRET or DISCORD_BOT_TOKEN
# disables the endpoint; a POLL_SECRET or HISTORY_SECRET equal to it also
# disables that secret's routes.
IVAO_WEBHOOK_SECRET=""

# Optional stable coordinator identity for an existing deployment.
# Leave empty for a new installation (defaults to onfreq). Set this to the
# existing object name BEFORE upgrading if it differs, to preserve all state.
COORDINATOR_NAME=""
